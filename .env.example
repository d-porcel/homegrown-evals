# Models are set as <provider>/<model>. Swap either one here; nothing else needs to change.
# All providers: https://inspect.aisi.org.uk/providers.html

# Model being tested
INSPECT_EVAL_MODEL=openai/gpt-6-astra
# Other examples:
#   anthropic/claude-opus-5-5
#   openrouter/qwen/<model>     hosted Qwen, and most other open models, with one key
#   together/Qwen/<model>       hosted Qwen on Together AI
#   ollama/qwen3:8b             local and free, needs Ollama running

# Judge: a different model from the one being tested. The run stops before any reply is written if the
# judge has the same name as the tested model, even through another provider, but it can't spot the same
# model under a different name, like a dated version.
# Prompt caching is off for the judge. Every judge prompt includes the reply it grades, so no two are
# alike and a cached prompt is never read back, while Anthropic charges 25% more to write one than to
# read the prompt plainly. In Davidness's earlier runs, with caching on, Opus wrote 868,000 tokens to
# its cache and read back 7,800. Keep the value free of spaces, since a space would split it into two settings.
INSPECT_EVAL_MODEL_ROLE='grader={"model":"anthropic/claude-opus-5-5","cache_prompt":false}'

# Where runs are saved. For smoke tests, add --log-dir logs/smoke
INSPECT_LOG_DIR=logs/runs

# Model prices, so every run records what it cost. List only models Inspect knows, as prices.yaml explains.
INSPECT_EVAL_MODEL_COST_CONFIG=prices.yaml

# API keys, for the providers you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
